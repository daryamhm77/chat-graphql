# Local (Vite proxy on :3001 → Nest :3000)
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001/api

# Production (Vercel) — set these in the Vercel project env, then redeploy.
# Point them at your Koyeb backend (no trailing slash after /api).
# VITE_API_URL=https://YOUR-APP.koyeb.app/api
# VITE_WS_URL=wss://YOUR-APP.koyeb.app/api
