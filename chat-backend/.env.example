# Local development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/chatter
JWT_SECRET=changeme
JWT_EXPIRATION=3600
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Optional per-bucket credentials (use these if users/messages buckets have separate keys)
# MINIO_USERS_ACCESS_KEY=
# MINIO_USERS_SECRET_KEY=
# MINIO_MESSAGES_ACCESS_KEY=
# MINIO_MESSAGES_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_USERS_BUCKET=chat-users
MINIO_MESSAGES_BUCKET=chat-messages
REDIS_HOST=localhost
REDIS_PORT=6379

# Production (Render) extras — see DEPLOY.md
# NODE_ENV=production
# COOKIE_SECURE=true
# FRONTEND_URL=https://your-app.vercel.app
# REDIS_PASSWORD=
# REDIS_TLS=true
# Free no-card storage example (Synclyz):
# MINIO_ENDPOINT=https://s3.synclyz.com
# MINIO_PUBLIC_URL=https://s3.synclyz.com
# If buckets use separate keys:
# MINIO_USERS_ACCESS_KEY=
# MINIO_USERS_SECRET_KEY=
# MINIO_MESSAGES_ACCESS_KEY=
# MINIO_MESSAGES_SECRET_KEY=
